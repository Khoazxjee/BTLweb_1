@model RoomDetailsPage
@{
    ViewData["Title"] = Model.Room.RoomType.Name;
    var room = Model.Room;
    var stay = Model.Stay;
}
<section class="container section">
    <a href="@(Model.ReturnUrl ?? Url.Action("Index", new { arrivalDate = stay.ArrivalDate.ToString("yyyy-MM-dd"), departureDate = stay.DepartureDate.ToString("yyyy-MM-dd"), guestCount = stay.GuestCount }))" class="back-link">← Quay lại danh sách phòng</a>
    <div class="section-heading">
        <div><div class="eyebrow">PHÒNG @room.RoomNumber · AURORA COLLECTION</div><h1>@room.RoomType.Name</h1></div>
        <span class="tag">Tối đa @room.RoomType.Capacity khách</span>
    </div>
    <img class="detail-hero" src="@room.ImagePath" alt="Không gian phòng @room.RoomType.Name" />
    <div class="detail-grid">
        <div>
            <div class="eyebrow">KHÔNG GIAN DÀNH CHO BẠN</div>
            <h2>Nghỉ ngơi thật thoải mái.</h2>
            <div class="rich-copy">@Html.Raw(CatalogService.Sanitize(room.Description))</div>
            <h3>Tiện nghi trong phòng</h3>
            <div class="amenity-list">
                @foreach (var amenity in room.Amenities.Split(',', StringSplitOptions.RemoveEmptyEntries))
                {
                    <span>✓ @amenity.Trim()</span>
                }
            </div>
            <div class="notice">Giá được chốt khi lễ tân xác nhận. Yêu cầu đặt phòng chưa được xác nhận sẽ chưa giữ chỗ.</div>
        </div>
        <aside class="panel booking-panel">
            <div class="eyebrow">LÊN KẾ HOẠCH KỲ NGHỈ</div>
            <h3>@Ui.Money(room.NightlyRate) <small>/ đêm</small>
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <form asp-controller="Bookings" asp-action="Select" method="post">
                <input type="hidden" name="RoomId" value="@room.Id" />
                <partial name="_StayFields" model="stay" />
                @if (ViewData.ModelState.IsValid)
                {
                    <div class="estimate-summary">
                        <small>@Model.Nights đêm theo lịch đang xem · Tiền phòng dự kiến</small>
                        <strong>@Ui.Money(Model.EstimatedTotal)</strong>
                    </div>
                }
                <p class="form-note">Bạn có thể xem lại tổng tiền theo lịch mới ở bước tiếp theo.</p>
                <button class="btn btn-primary w-100 mt-4">Tiếp tục đặt phòng →</button>
                <p class="form-note">Đăng nhập để gửi yêu cầu. Chưa thanh toán ở bước này.</p>
            </form>
        </aside>
    </div>
</section>
