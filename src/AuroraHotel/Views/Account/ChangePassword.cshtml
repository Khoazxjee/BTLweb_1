@model ChangePasswordInput
@{
    ViewData["Title"] = "Đổi mật khẩu";
    if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Receptionist))
        Layout = "_StaffLayout";
}
<section class="container section narrow-section">
    <div class="eyebrow">BẢO MẬT TÀI KHOẢN</div>
    <h1>Đổi mật khẩu</h1>
    <p class="page-subtitle">Bảo vệ tài khoản của bạn bằng một mật khẩu riêng.</p>
    <form method="post" class="panel">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <div class="field">
            <label asp-for="CurrentPassword"></label>
            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" required />
        </div>
        <div class="field">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" required minlength="8" maxlength="100" />
            <small>Ít nhất 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</small>
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required />
        </div>
        <button class="btn btn-primary">Lưu mật khẩu mới</button>
    </form>
</section>
